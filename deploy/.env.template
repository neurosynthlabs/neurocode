# NeuroCode on a server. setup-vm.sh copies this to .env and fills the secrets with random values; nothing here
# is ever committed with a value.

# The name people type. Its DNS A record must point at this machine before the first start, so Caddy can get the
# certificate.
DOMAIN=eurex.dev

# The database: the superuser (only the init script uses it) and the application's own role.
POSTGRES_PASSWORD=
NEUROCODE_DB_PASSWORD=

# Asked once, by the setup wizard, before anyone may create the first Owner — so nobody who finds the address
# first can claim the workspace. setup-vm.sh prints it.
NEUROCODE_SETUP_TOKEN=

# Served over HTTPS only.
NEUROCODE_COOKIE_SECURE=true

# Browsing folders, a terminal, running and debugging on THIS server. Off: turning it on hands whoever signs in
# as an Owner a shell on this machine.
NEUROCODE_MACHINE_ACCESS=false

# Model keys can be set here or later in Admin → AI providers (which keeps them in /data/secrets.json).
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
