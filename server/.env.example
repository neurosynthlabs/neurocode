# Copy to server/.env (git-ignored). Read when the API starts; real environment variables win.

# Which planner compiles requirements: auto | deepseek | ollama | rules
# auto tries DeepSeek (if a key is set), then Ollama (if it has the model), then the offline planner.
NEUROCODE_COMPILER=auto

# DeepSeek: cheap and fast. The requirement text and the memory facts that match it are sent to it.
# DEEPSEEK_API_KEY=sk-...
# NEUROCODE_DEEPSEEK_MODEL=deepseek-chat

# Ollama: local, nothing leaves the machine, but the model needs free RAM (a 7B model wants ~5 GB).
# NEUROCODE_OLLAMA_URL=http://127.0.0.1:11434
# NEUROCODE_OLLAMA_MODEL=qwen2.5-coder:7b
